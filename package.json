{
  "name": "desk-pets",
  "version": "1.0.2",
  "description": "千千猫猫和梨梨兔兔的 Windows 桌宠",
  "main": "main.js",
  "author": "千千",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "dist": "electron-builder --win nsis --publish never"
  },
  "build": {
    "appId": "com.lumi729.deskpets",
    "productName": "千千梨梨桌宠",
    "files": [
      "main.js",
      "preload.js",
      "lib/**",
      "renderer/**",
      "桌宠素材/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "桌宠素材/托盘图标/千千猫猫.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "installerIcon": "桌宠素材/托盘图标/千千猫猫.ico",
      "uninstallerIcon": "桌宠素材/托盘图标/千千猫猫.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "千千梨梨桌宠",
      "artifactName": "desk-pets-setup-${version}.${ext}",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Lumi729",
        "repo": "desk-pets",
        "releaseType": "draft"
      }
    ]
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Lumi729/desk-pets.git"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
